# People Suq — environment variables
# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Shopify Storefront API (powers the Merch shop + checkout) ---
# Your store domain (the *.myshopify.com one, not a custom domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront API access token from a Shopify custom app (public/client-safe,
# but kept server-side here). Required to show live products + enable checkout.
SHOPIFY_STOREFRONT_TOKEN=
# Handle of the Shopify collection that holds ONLY People Suq / cause merch,
# so SUQ MEDIA's commercial apparel never appears on this site.
# Leave empty to pull the whole catalog (not recommended).
SHOPIFY_COLLECTION_HANDLE=people-suq
# Storefront API version (optional; defaults to a known-good version).
# SHOPIFY_API_VERSION=2024-10
